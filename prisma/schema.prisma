// CRM / DMS placeholder schema for lubricant oil distribution.
// Provider: PostgreSQL (Supabase-compatible).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — required with Supabase PgBouncer
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SALES
  FLEET
  DEALER
  ACCOUNTANT
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CustomerType {
  GARAGE
  FLEET
}

enum DealerTier {
  RETAIL
  SILVER
  GOLD
}

enum MeterUnit {
  KM
  HOUR
}

enum PointLedgerReason {
  SCAN
  REDEEM
}

enum DrumTxnType {
  ISSUE
  RETURN
  ADJUST
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum DebtPaymentStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum VisitDayOfWeek {
  T2
  T3
  T4
  T5
  T6
  T7
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  phone            String?
  role             UserRole          @default(SALES)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  checkIns         VisitCheckIn[]
  drumTransactions DrumTransaction[]
  debtPayments     DebtPayment[]
  chatMessages     ChatMessage[]
  chatReadStatus   ChatReadStatus[]
  approvalRequestsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalRequestsActed     ApprovalRequest[] @relation("ApprovalActor")
}

/// Group chat messages visible to all users in the system
model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([senderId])
}

/// Tracks per-user last-read timestamp for the group chat channel
model ChatReadStatus {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@index([userId])
}

model Product {
  id               String            @id @default(cuid())
  sku              String            @unique
  name             String
  viscosity        String?
  standard         String?
  volume           String?
  volumeLiters     Float?
  unitPrice        Decimal           @db.Decimal(12, 2)
  wholesalePrice   Decimal?          @db.Decimal(12, 2)
  garagePrice      Decimal?          @db.Decimal(12, 2)
  retailPrice      Decimal?          @db.Decimal(12, 2)
  stock            Int               @default(0)
  isDrum           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            OrderItem[]
  drumTransactions DrumTransaction[]
}

/// Supports offline capture via localId before server sync.
model Order {
  id                       String            @id @default(cuid())
  localId                  String?           @unique
  status                   OrderStatus       @default(DRAFT)
  userId                   String
  user                     User              @relation(fields: [userId], references: [id])
  customerId               String
  customer                 Customer          @relation(fields: [customerId], references: [id])
  discountPercent          Float             @default(0)
  discountAmount           Decimal           @default(0) @db.Decimal(14, 2)
  promotionNotes           String?
  totalLiters              Float             @default(0)
  drumDelivered            Int               @default(0)
  drumReturned             Int               @default(0)
  drumDepositAmount        Decimal           @default(0) @db.Decimal(14, 2)
  isCreditOverride         Boolean           @default(false)
  creditOverrideReason     String?
  creditOverrideStatus     String?           @default("NONE")
  creditOverrideApprovedBy String?
  syncedAt                 DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  items                    OrderItem[]
  drumTransactions         DrumTransaction[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
}

model Customer {
  id                       String            @id @default(cuid())
  name                     String
  phone                    String?
  address                  String?
  type                     CustomerType      @default(GARAGE)
  dealerTier               DealerTier        @default(SILVER)
  creditLimit              Decimal           @default(0) @db.Decimal(14, 2)
  creditTermDays           Int               @default(30)
  currentDebt              Decimal           @default(0) @db.Decimal(14, 2)
  outstandingDrums         Int               @default(0)
  creditOverridden         Boolean           @default(false)
  creditOverrideReason     String?
  creditOverrideApprovedBy String?
  lat                      Decimal?          @db.Decimal(10, 7)
  lng                      Decimal?          @db.Decimal(10, 7)
  visitDay                 VisitDayOfWeek?
  visitDays                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  orders                   Order[]
  checkIns                 VisitCheckIn[]
  visitPlans               CustomerVisitPlan[]
  vehicles                 FleetVehicle[]
  drumTransactions         DrumTransaction[]
  debtPayments             DebtPayment[]
}

model CustomerVisitPlan {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visitDate  DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  @@unique([customerId, visitDate])
  @@index([visitDate])
}

model DebtPayment {
  id            String            @id @default(cuid())
  receiptNumber String            @unique
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(14, 2)
  method        PaymentMethod     @default(CASH)
  notes         String?
  status        DebtPaymentStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  cancelledBy   String?
  cancelledAt   DateTime?
  cancelReason  String?
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([status])
  @@index([createdAt])
}

model DrumTransaction {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  type            DrumTxnType
  quantity        Int
  depositDeducted Decimal?    @default(0) @db.Decimal(14, 2)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id])
  orderId         String?
  order           Order?      @relation(fields: [orderId], references: [id])
  notes           String?
  signedBy        String?
  signature       String?
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  createdAt       DateTime    @default(now())
}

model FleetVehicle {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  plateNumber      String    @unique
  label            String?
  unit             MeterUnit @default(KM)
  currentMeter     Int
  lastServiceMeter Int
  intervalValue    Int
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model VisitCheckIn {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  distanceM  Float
  createdAt  DateTime @default(now())
}

model Mechanic {
  id           String             @id @default(cuid())
  name         String
  phone        String             @unique
  points       Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  codes        LoyaltyCode[]
  ledger       PointLedger[]
  redemptions  RewardRedemption[]
}

model LoyaltyCode {
  id         String    @id @default(cuid())
  code       String    @unique
  points     Int       @default(10)
  productSku String?
  redeemedAt DateTime?
  mechanicId String?
  mechanic   Mechanic? @relation(fields: [mechanicId], references: [id])
  createdAt  DateTime  @default(now())
}

model LoyaltyReward {
  id          String             @id @default(cuid())
  name        String
  pointsCost  Int
  stock       Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions RewardRedemption[]
}

model PointLedger {
  id         String            @id @default(cuid())
  mechanicId String
  mechanic   Mechanic          @relation(fields: [mechanicId], references: [id])
  delta      Int
  reason     PointLedgerReason
  refId      String?
  note       String?
  createdAt  DateTime          @default(now())
}

model RewardRedemption {
  id          String        @id @default(cuid())
  mechanicId  String
  mechanic    Mechanic      @relation(fields: [mechanicId], references: [id])
  rewardId    String
  reward      LoyaltyReward @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  createdAt   DateTime      @default(now())
}

enum ApprovalTargetType {
  DEBT_RECEIPT            // Phiếu thu nợ
  ORDER_CREDIT_OVERRIDE   // Đơn vượt hạn mức nợ
  SPECIAL_DISCOUNT        // Chiết khấu đơn hàng
  DRUM_ADJUSTMENT         // Điều chỉnh cọc / vỏ phuy
  CREDIT_LIMIT_CHANGE     // Nâng hạn mức công nợ
}

enum ApprovalStatus {
  PENDING    // Đang chờ duyệt
  APPROVED   // Đã phê duyệt
  REJECTED   // Đã từ chối
  CANCELLED  // Người lập tự hủy
}

model ApprovalRequest {
  id              String             @id @default(cuid())
  targetType      ApprovalTargetType
  targetId        String             // ID bản ghi gốc
  targetCode      String             // Mã hiển thị (PT-..., ORD-...)
  title           String             // Tiêu đề tóm tắt
  summary         String?            // Chi tiết ngắn gọn
  amount          Decimal?           @db.Decimal(14, 2)
  metadata        Json?              // Dữ liệu mở rộng
  
  requiredRole    String             @default("ADMIN") // ADMIN | ACCOUNTANT
  requesterId     String
  requester       User               @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  
  status          ApprovalStatus     @default(PENDING)
  decisionReason  String?
  actionBy        String?
  actionUser      User?              @relation("ApprovalActor", fields: [actionBy], references: [id], onDelete: SetNull)
  actionAt        DateTime?
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([requesterId])
}

model SystemSetting {
  id                         String   @id @default("default")
  companyName                String   @default("Công Ty TNHH Phân Phối Dầu Nhớt Remix Petro")
  hotline                    String   @default("1900 6868")
  centralWarehouseAddress    String   @default("Kho Tổng QL1A, Huyện Bình Chánh, TP. Hồ Chí Minh")
  vatRatePercent             Float    @default(8)
  geofenceRadiusMeters       Int      @default(50)
  gpsAccuracyThresholdMeters Int      @default(30)
  requirePhotoAtCheckin      Boolean  @default(true)
  defaultCreditLimit         Decimal  @default(100000000) @db.Decimal(14, 2)
  overdueWarningDays         Int      @default(30)
  creditLockOverdueDays      Int      @default(45)
  drumDepositPrice           Decimal  @default(400000) @db.Decimal(14, 2)
  maxDrumHoldDays            Int      @default(45)
  loyaltyPointConversionRate Decimal  @default(10000) @db.Decimal(14, 2)
  rewardPointsPerDrum        Int      @default(20)
  offlineAutoSyncIntervalMin Int      @default(5)
  updatedBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

# =============================================================================
# Environment variables — CRM Dầu Nhớt (Next.js + Supabase + Prisma)
# Copy to `.env` locally. On Vercel: Project → Settings → Environment Variables.
# NEVER commit real secrets. `.env` / `.env*.local` are gitignored.
# =============================================================================

# --- Prisma / PostgreSQL (Supabase) ------------------------------------------
# App runtime: Transaction pooler (port 6543) + pgbouncer=true
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations / db push: Session mode (port 5432) or direct DB host
# Required because schema.prisma sets `directUrl = env("DIRECT_URL")`
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth / JS client (Project Settings → API) ----------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
